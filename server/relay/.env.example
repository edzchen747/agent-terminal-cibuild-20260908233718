# Public DNS name for the Headscale control plane and embedded DERP server.
NODE_DOMAIN=node.hopto.org
HEADSCALE_PUBLIC_URL=https://node.hopto.org

# Pin the server image; update deliberately with the matching config example.
HEADSCALE_VERSION=0.29.3

# Set this to the server's public address. Leave IPv6 empty when unused.
HEADSCALE_PUBLIC_IPV4=
HEADSCALE_PUBLIC_IPV6=
TAILNET_BASE_DOMAIN=agent-terminal.internal

# Server-only Headscale API credentials. Use separate keys so either can be
# rotated without touching an app. They are never returned by Caddy.
HEADSCALE_PROVISION_API_KEY=
HEADSCALE_REAPER_API_KEY=

# Enrollment capabilities are public but very short-lived. The provisioner
# creates an isolated Headscale user for each paired host; apps hold no server
# credential and cannot choose a user, tag, lifetime, or key policy.
PROVISIONING_KEY_TTL_SECONDS=300
PROVISIONING_ACTIVATION_TTL_SECONDS=45
PROVISIONING_RATE_WINDOW_SECONDS=60
PROVISIONING_NONCE_RETENTION_SECONDS=3600
PROVISIONING_SOURCE_RATE_LIMIT=12
PROVISIONING_SUBNET_RATE_LIMIT=32
PROVISIONING_HOST_RATE_LIMIT=12
PROVISIONING_DESKTOP_RATE_LIMIT=4
PROVISIONING_MOBILE_RATE_LIMIT=6
PROVISIONING_GLOBAL_RATE_LIMIT=500
PROVISIONING_MAX_CONCURRENT_ENROLLMENTS=4
PROVISIONING_MAX_CONNECTIONS=128
PROVISIONING_MAX_ACTIVE_ACTIVATIONS=10000
PROVISIONING_UPSTREAM_TIMEOUT_MS=8000

NODE_INACTIVITY_DAYS=30
NODE_REAPER_INTERVAL_SECONDS=3600

# Caddy uses this only as the ACME account contact address.
CADDY_EMAIL=
