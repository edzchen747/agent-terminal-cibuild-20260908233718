{
  "name": "@agentterminal/desktop",
  "version": "0.3.5",
  "private": true,
  "description": "Windows terminal host for the Agent Terminal mobile companion.",
  "author": "Agent Terminal contributors",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts --configLoader runner",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/renderer/src/split-tabs.test.ts",
    "package:win": "tauri build --no-bundle"
  },
  "dependencies": {
    "@agentterminal/protocol": "*",
    "@tauri-apps/api": "^2.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@tauri-apps/cli": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  }
}
