{
  "name": "@agentterminal/desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Windows terminal host for the Agent Terminal mobile companion.",
  "author": "Agent Terminal contributors",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@agentterminal/protocol": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.agentterminal.desktop",
    "productName": "Agent Terminal",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "npmRebuild": false,
    "asarUnpack": ["node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
