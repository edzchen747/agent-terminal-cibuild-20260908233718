{
  "name": "agent-terminal",
  "version": "0.3.2",
  "private": true,
  "description": "A Windows terminal that can be securely controlled from a paired mobile device.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "dev": "npm run dev -w @agentterminal/desktop",
    "dev:mobile": "npm run dev -w @agentterminal/mobile",
    "build": "npm run build -w @agentterminal/protocol && npm run build -w @agentterminal/relay && npm run build -w @agentterminal/desktop && npm run build -w @agentterminal/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "android:sync": "npm run android:sync -w @agentterminal/mobile",
    "android:open": "npm run android:open -w @agentterminal/mobile",
    "desktop:portable": "npm run package:win -w @agentterminal/desktop"
  },
  "engines": {
    "node": ">=22"
  }
}
